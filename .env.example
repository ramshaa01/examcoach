GEMINI_API_KEY=your_google_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_claude_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Which provider agents use by default: gemini | claude | openai
EXAMCOACH_LLM_PROVIDER=gemini

# Optional: override the SQLite database file path (defaults to examcoach.db)
EXAMCOACH_DB_PATH=examcoach.db
